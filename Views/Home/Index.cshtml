@{
    ViewData["Title"] = "UrlOpener";
}

<div class="max-w-3xl w-full">

    <div class="bg-white rounded-2xl shadow-sm border p-10">

        <!-- Title -->
        <h1 class="text-3xl font-semibold text-center text-gray-900">
            Open URLs with Delay
        </h1>

        <p class="text-center mt-2 text-gray-500">
            Paste your URLs below and open them automatically with a configurable timed delay.
        </p>


        <!-- FORM -->
        <form class="mt-8 space-y-6" onsubmit="startOpening(event)">

            <!-- Textarea -->
            <div>
                <label class="text-sm font-medium text-gray-700">
                    Paste URLs
                    <span class="text-gray-400 text-xs">(one per line)</span>
                </label>

                <textarea id="urls"
                          rows="7"
                          class="mt-2 w-full rounded-xl border px-4 py-3 text-gray-700 focus:ring-2 focus:ring-indigo-300 outline-none"
                          placeholder="google.com&#10;youtube.com&#10;example.org"></textarea>
            </div>


            <!-- Delay -->
            <div class="bg-gray-50 border rounded-xl p-5 flex items-center justify-between">

                <div>
                    <div class="font-medium text-gray-800">
                        Delay Duration
                    </div>
                    <div class="text-sm text-gray-500">
                        Seconds between opening each tab
                    </div>
                </div>

                <input id="delay"
                       type="number"
                       value="1"
                       min="0"
                       class="w-20 text-center border rounded-xl py-2 focus:ring-2 focus:ring-indigo-300 outline-none" />
            </div>


            <!-- Button -->
            <button type="submit"
                    class="w-full bg-indigo-400 hover:bg-indigo-500 text-white font-semibold py-3 rounded-xl shadow-sm transition">
                Start Opening
            </button>

        </form>

    </div>


    <!-- Footer Notice -->
    <div class="text-center text-gray-500 text-sm mt-6">
        ⚠ You may need to allow pop-ups for this website in your browser settings.
    </div>

</div>


<script>
    async function startOpening(e) {
        e.preventDefault();

        const urls = document.getElementById("urls")
            .value.split("\n")
            .map(x => x.trim())
            .filter(x => x.length > 0);

        let delay = parseFloat(document.getElementById("delay").value) * 1000;

        for (let url of urls) {

            if (!url.startsWith("http"))
                url = "https://" + url;

            window.open(url, "_blank");

            if (delay > 0)
                await new Promise(r => setTimeout(r, delay));
        }
    }
</script>
